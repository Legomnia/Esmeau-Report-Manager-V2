# Variables d'environnement requises
# Copier ce fichier en .env.local et renseigner les valeurs

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Google OAuth Client ID (pour export PDF vers Google Drive)
# Obtenir depuis https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Note : la clé API OpenRouter est configurée côté serveur
# dans les secrets Supabase (OPENROUTER_API_KEY), pas ici.
